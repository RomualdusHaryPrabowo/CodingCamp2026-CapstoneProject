# =============================================
# MATCHSTEP AI — Frontend Environment Variables
# =============================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke repositori!
# =============================================

# --- Google OAuth 2.0 ---
# Client ID untuk autentikasi Google Sign-In
# Dapatkan di: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID="your-google-client-id-here"

# --- Backend API ---
# URL endpoint backend API
# Development: http://localhost:3000
# Production : https://backend.matchstepai.my.id
VITE_BACKEND_URL="http://localhost:3000"
